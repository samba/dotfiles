#!/usr/bin/env zsh


function retryloop () {
    local timeout=$1; shift;

    while ! $@ ; do sleep ${timeout} ; done
}

# NB: this probably won't work with zim title plugin
function set_terminal_title () {
    echo -en "\e]2;$@\a"
}


function gen_passwd () {
    printf "%s\n" "$(tr -dc A-Za-z0-9 </dev/urandom | head -c ${1:-13})"
}

function brew_cask_upgrade () {
    command -v brew && brew upgrade $(brew outdated --cask --greedy --quiet)
}


function ssh_fingerprints () {
  find ${HOME}/.ssh -name '*rsa' | while read f; do
  echo $(ssh-keygen -E md5  -lf "${f}") "($f)"
  done
}


# Quickly attach to a named (or default) tmux session
function tma () {
    tmux new-session -A -s ${1:-main}
}


# Search, edit, preview, and quickly jot notes, either by title, keyword or date
# Typically I alias this as `note`
function _znote () {

    local notesdir="${NOTES:-${HOME}/.notes}"
    local vimopts="--ttyfail -p -Z"
    local listfmt="${fg[cyan]}%TF${reset_color}\t%f\n"
    local bin_search="grep"
    local pager="${PAGER:-less}"

    command -v bat >/dev/null && pager="bat"
    command -v ag > /dev/null && bin_search="ag"

    type colors >/dev/null && colors

    mkdir -p "${notesdir}"

    local mode=() search=() title=() fname=

    zparseopts -D -E -K -- \
        {t,-title}:=title \
        {s,-search}:=search \
        {d,-daily}=title \
        {l,-list}=mode \
        {v,-view}=mode \
        {e,-edit}=mode \
        {h,-help}=mode \
        || return 1

    # keep only their arguments
    title=("${(@)title:#-t}")
    search=("${(@)search:#-s}")

    # search provides content match by default...
    if (( $#search > 0 && $#mode < 1 )) ; then
        mode=("--search")
    elif (( $#mode < 1 )) ; then
        mode=("--list")
    fi

    case "${title[-1]}" in
        --daily|-d)
            title=("$(date "+%Y-%m-%d") Daily Notes")
            ;;
    esac


    if (( $#title )) ; then
        fname="$(echo "${title[@]}" | tr -C -s '[:alnum:]' '-' | tr -s '[:upper:]' '[:lower:]' | sed 's@-$@@')"
        fname="${notesdir}/${fname%%.md}.md"
    fi

    case "${mode[-1]}" in
        --search)
            PAGER=${pager} ${bin_search} -r "${search}" "${(@)@:#--}"  ${notesdir}
            ;;
        --list|-l|NONE)
            if (( $#fname )) ; then
                find ${fname} -printf "${listfmt}"
            elif (( $#search )) ; then
                ${bin_search} -rl "${search}" "${(@)@:#--}"  ${notesdir}
            else
                find ${notesdir}/ -type f -name '*.md' -printf "${listfmt}"
            fi
            ;;
        --view|-v)
            if (( $#fname )) ; then
                find ${fname} -print0 | xargs -r --null ${pager}
            elif (( $#search )) ; then
                ${bin_search} -rl "${search}" "${(@)@:#--}"  ${notesdir} | xargs -r ${pager}
            else
                find ${notesdir}/ -type f -name '*.md' -print0 | xargs -r --null ${pager}
            fi
            ;;
        --edit|-e)
            if (( $#fname )) ; then
                # Create the file if not exists
                test -f ${fname} || echo -e "---\ntitle: ${title[@]}\ndate: $(date "+%Y-%m-%d %H:%M:%S")\n---\n\n" > ${fname}

                case ${EDITOR} in
                    *vim) ${EDITOR} -p  ${vimopts} ${fname} ; return ;;
                    *) ${EDITOR} ${fname} ; return ;;
                esac

            elif (( $#search )) ; then
                case ${EDITOR} in
                    *vim)
                        zargs -- $(${bin_search} -lr "${search}" "${(@)@:#--}" ${notesdir}) -- ${EDITOR} -p ${vimopts}
                        return
                        ;;
                    *)
                        zargs -- $(${bin_search} -lr "${search}" "${(@)@:#--}" ${notesdir}) -- ${EDITOR}
                        return
                        ;;
                esac
            else
                case ${EDITOR} in
                    # NB: I cannot infer that other editors will do the right thing with a direcotry...
                    *vim)
                        ${EDITOR} ${vimopts} ${notesdir}
                        ;;
                esac
            fi


            ;;
        --help|-h)

            echo "usage: ${0} [-edlv] [-s pat] [-t title] [-- <more search args>]"
            echo "\t -l        \t Only list matching notes. (default)"
            echo "\t -e        \t Edit these files, instead of just listing them."
            echo "\t -v        \t Preview matching notes in pager (${pager})."
            echo "\t -d        \t Quick access to daily notes. (aliases the current date as title)"
            echo "\t -t <title>\t Look for a specific note of a given title. If found list this file."
            echo "\t -s <pat>  \t Search (using ${bin_search}) all notes for a given pattern."

            echo "Options -s with terminal arguments (-- [args]) will pass them to ${bin_search} directly."
            return 0

            ;;
    esac


}

function pasteup () {
    curl --data-binary @${1:-"-"} https://paste.rs/
}

function pastedel () {
    curl -X DELETE https://paste.rs/${1}
}

# Force colorful grep in a pager.
function cgrep () {
    grep "${@}" --color=always | less -R
}

# Simple shortcut for read-only vim w/ arbitrary filetype coloring
function cview () {
  local ft="$1"; shift;
  if test $# -eq 0; then
    vim -R -c "set ft=${ft}" -
  else
    vim -R -c "set ft=${ft}" "$@"
  fi
}

# Find all keymappings in my vim config, and open them in a pager w/ color output
function vim_shortcuts () {
    cgrep -B 3 -E "[ivn](nore)?map\s+([^ ]+)" ~/.vimrc ~/.vim/ftplugin/*.vim
}


function wtf () {
    type colors >/dev/null && colors
    printf "%s${USER}${reset_color}@%s${HOST:-$(hostname)}${reset_color} %s$(pwd)${reset_color}\n" \
        "${fg[green]}" "${fg[yellow]}" "${fg[cyan]}"
    command -v kubectl >/dev/null && \
        printf "${fg[green]}%s${reset_color}\n" "$(kubectl version | sed 's%^%kubectl: %')" && \
        printf "${fg[cyan]}kubeconfig: %s${reset_color}\n" "${KUBECONFIG}" && \
        printf "${fg[magenta]}kube context: %s${reset_color}\n" "$(kubectl config current-context)"
    command -v go >/dev/null && printf "${fg[yellow]}%s${reset_color}\n" "$(go version)"
    command -v python3 >/dev/null && printf "${fg[blue]}%s${reset_color}\n" "$(python3 --version)"
    echo && \
    command -v git >/dev/null && git status --short --column --ahead-behind --untracked=no
}


# To avoid accidental commands on prod clusters...
export SAFE_KUBECONFIG=${HOME}/.kube/safe.kubeconfig
export PROD_KUBECONFIG=${HOME}/.kube/prod.kubeconfig

# default to safety
export KUBECONFIG=${SAFE_KUBECONFIG}

function use_env () {
    echo "# usage:  eval \$(use_env [safe|prod]) 2>/dev/null" >&2
    case "${1}" in
        prod)
            echo "export KUBECONFIG=${PROD_KUBECONFIG}"
            ;;
        safe|*)
            echo "export KUBECONFIG=${SAFE_KUBECONFIG}"
            ;;
    esac

}

function kctx () {
    local arg="${1:-current}"
    shift
    case "${arg}" in
        -h|help) echo -e "Kubernetes context. Usage: kctx <verb> <options>. \nVerbs are: list, use, set, rename, delete, current\n" ;;
        -l|list) kubectl config get-contexts "${@}" ;;
        -u|use) kubectl config use-context "${@}" ;;
        -d|delete) kubectl config delete-context "${@}" ;;
        -r|rename) kubectl config rename-context "${@}" ;;
        -s|set) kubectl config set-context "${@}" ;;
        -c|current) kubectl config current-context "${@}" ;;
    esac
}
